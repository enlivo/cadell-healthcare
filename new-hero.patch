+import { useMemo, useState } from 'react';
+import { ArrowRight, BadgeCheck, Cross, MessageCircle } from 'lucide-react';
+import { Link } from 'react-router-dom';
+import { productCatalog } from '../data/productCatalog.generated.js';
+
+const categoryStyles = {
+  cardiac: { tile: 'bg-rose-50 border-rose-200/70 hover:border-rose-400', dot: 'bg-rose-500', text: 'text-rose-700' },
+  diabetic: { tile: 'bg-sky-50 border-sky-200/70 hover:border-sky-400', dot: 'bg-sky-500', text: 'text-sky-700' },
+  'general-medicine': { tile: 'bg-emerald-50 border-emerald-200/70 hover:border-emerald-400', dot: 'bg-emerald-500', text: 'text-emerald-700' },
+  gynaecology: { tile: 'bg-violet-50 border-violet-200/70 hover:border-violet-400', dot: 'bg-violet-500', text: 'text-violet-700' },
+  orthopedic: { tile: 'bg-amber-50 border-amber-200/70 hover:border-amber-400', dot: 'bg-amber-500', text: 'text-amber-700' },
+};
+
+const TILE_LIMIT = 30;
+const MOBILE_TILE_LIMIT = 20;
+
+const buildTiles = () => {
+  const groups = Object.entries(productCatalog).map(([slug, category]) => ({
+    slug,
+    label: category.label,
+    products: category.products,
+  }));
+  const tiles = [];
+  for (let round = 0; tiles.length < TILE_LIMIT; round += 1) {
+    let added = false;
+    groups.forEach((group) => {
+      const product = group.products[round];
+      if (product && tiles.length < TILE_LIMIT) {
+        tiles.push({ ...product, slug: group.slug, categoryLabel: group.label });
+        added = true;
+      }
+    });
+    if (!added) break;
+  }
+  return tiles;
+};
+
+const symbolFor = (name) => {
+  const word = name.split(' ')[0];
+  return word.charAt(0).toUpperCase() + word.slice(1, 3).toLowerCase();
+};
+
+const totalBrands = Object.values(productCatalog).reduce((sum, category) => sum + category.products.length, 0);
+
+function MoleculeLines() {
+  return (
+    <svg
+      aria-hidden="true"
+      viewBox="0 0 400 400"
+      className="pointer-events-none absolute -right-16 -top-10 h-[420px] w-[420px] text-[#0B2A57] opacity-[0.06]"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.5"
+    >
+      <polygon points="200,40 270,80 270,160 200,200 130,160 130,80" />
+      <polygon points="270,160 340,200 340,280 270,320 200,280 200,200" />
+      <polygon points="130,160 200,200 200,280 130,320 60,280 60,200" />
+      <circle cx="200" cy="40" r="7" />
+      <circle cx="340" cy="200" r="7" />
+      <circle cx="60" cy="280" r="7" />
+      <line x1="200" y1="320" x2="200" y2="380" />
+      <circle cx="200" cy="380" r="7" />
+    </svg>
+  );
+}
+
+export default function HeroPeriodicTable() {
+  const tiles = useMemo(() => buildTiles(), []);
+  const [active, setActive] = useState(null);
+
+  return (
+    <section
+      className="relative flex min-h-[100svh] flex-col overflow-hidden bg-[#F6F8F7] pt-[88px] text-[#0B2A57] md:pt-24"
+      aria-labelledby="hero-heading"
+    >
+      <div
+        aria-hidden="true"
+        className="pointer-events-none absolute inset-0 opacity-60"
+        style={{
+          backgroundImage:
+            'linear-gradient(rgba(11,42,87,0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(11,42,87,0.045) 1px, transparent 1px)',
+          backgroundSize: '44px 44px',
+        }}
+      />
+      <MoleculeLines />
+
+      <div className="relative z-10 mx-auto flex w-full max-w-[1320px] flex-1 items-center px-6 py-10 sm:px-8 lg:px-10">
+        <div className="grid w-full items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14">
+          <div className="hero-text-fade">
+            <div className="mb-7 inline-flex max-w-full items-center gap-2 rounded-full border border-[#0B2A57]/15 bg-white px-4 py-2 text-[10px] font-bold uppercase tracking-[0.14em] text-[#0B2A57] sm:text-xs sm:tracking-[0.2em]">
+              <Cross className="h-4 w-4 text-[#C0392B]" aria-hidden="true" />
+              <span className="min-w-0">Pharmaceutical &amp; Healthcare Solutions</span>
+            </div>
+            <h1 id="hero-heading" className="text-[40px] font-extrabold leading-[1.05] tracking-tight sm:text-6xl lg:text-[64px]">
+              Advancing Healthcare.
+              <span className="mt-1 block font-serif font-normal italic text-[#0E4D86]">Empowering Lives.</span>
+            </h1>
+            <p className="mt-6 max-w-xl text-base leading-8 text-slate-600 md:text-lg">
+              Every Cadell brand is formulated with scientific integrity and manufactured at WHO-GMP certified facilities.
+              Explore the portfolio below, one brand at a time.
+            </p>
+            <div className="mt-8 flex flex-col gap-4 sm:flex-row">
+              <Link
+                to="/products"
+                className="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#0B2A57] px-8 py-4 text-sm font-bold text-white shadow-[0_14px_34px_rgba(11,42,87,0.25)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#0E4D86] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0E4D86] sm:w-auto"
+              >
+                Explore Our Brand Portfolio
+                <ArrowRight size={18} aria-hidden="true" />
+              </Link>
+              <Link
+                to="/contact"
+                className="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#0B2A57] bg-transparent px-8 py-4 text-sm font-bold text-[#0B2A57] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#0B2A57] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0E4D86] sm:w-auto"
+              >
+                <MessageCircle size={18} aria-hidden="true" />
+                Partner With Us
+              </Link>
+            </div>
+          </div>
+
+          <div className="w-full">
+            <div className="relative rounded-3xl border border-[#0B2A57]/10 bg-white/80 p-3 shadow-[0_30px_80px_rgba(11,42,87,0.10)] backdrop-blur sm:p-4">
+              <div className="mb-3 flex items-center justify-between px-1 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">
+                <span>The Cadell Table</span>
+                <span className="hidden gap-3 sm:flex">
+                  {Object.entries(categoryStyles).map(([slug, style]) => (
+                    <span key={slug} className="inline-flex items-center gap-1.5">
+                      <span className={`h-2 w-2 rounded-full ${style.dot}`} />
+                      {productCatalog[slug]?.label.split(' ')[0]}
+                    </span>
+                  ))}
+                </span>
+              </div>
+
+              <div className="hero-table relative">
+                <div className="grid grid-cols-4 gap-1.5 sm:grid-cols-5 sm:gap-2 lg:grid-cols-6">
+                  {tiles.map((tile, index) => {
+                    const style = categoryStyles[tile.slug];
+                    return (
+                      <Link
+                        key={`${tile.slug}-${tile.name}`}
+                        to={`/products?category=${tile.slug}`}
+                        aria-label={`${tile.name}, ${tile.categoryLabel}`}
+                        onMouseEnter={() => setActive(tile)}
+                        onFocus={() => setActive(tile)}
+                        onMouseLeave={() => setActive(null)}
+                        onBlur={() => setActive(null)}
+                        style={{ animationDelay: `${index * 45}ms` }}
+                        className={`hero-tile-in group relative aspect-square flex-col justify-between rounded-xl border p-1.5 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg focus-visible:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0E4D86] sm:p-2 ${style.tile} ${
+                          index >= MOBILE_TILE_LIMIT ? 'hidden sm:flex' : 'flex'
+                        }`}
+                      >
+                        <span className={`text-[9px] font-bold tabular-nums ${style.text}`}>{String(index + 1).padStart(2, '0')}</span>
+                        <span className="text-center text-xl font-extrabold leading-none text-[#0B2A57] sm:text-2xl">{symbolFor(tile.name)}</span>
+                        <span className="line-clamp-2 text-center text-[8px] font-semibold uppercase leading-tight tracking-wide text-slate-600 sm:text-[9px]">
+                          {tile.name}
+                        </span>
+                      </Link>
+                    );
+                  })}
+                </div>
+                <div aria-hidden="true" className="hero-scan pointer-events-none absolute inset-0 rounded-xl" />
+              </div>
+
+              <div className="mt-3 min-h-[56px] rounded-xl bg-[#0B2A57] px-4 py-2.5 text-white" aria-live="polite">
+                {active ? (
+                  <>
+                    <p className="text-sm font-bold">
+                      {active.name} <span className="ml-1 text-[11px] font-semibold uppercase tracking-wider text-sky-200">{active.categoryLabel}</span>
+                    </p>
+                    <p className="line-clamp-1 text-xs text-slate-200">{active.composition || 'View details in the portfolio'}</p>
+                  </>
+                ) : (
+                  <p className="pt-2 text-xs text-slate-200">Hover or tap a brand to see its category and composition.</p>
+                )}
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div className="relative z-10 border-t border-[#0B2A57]/10 bg-white">
+        <div className="mx-auto flex max-w-[1320px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-4 text-sm font-semibold sm:px-8 lg:px-10">
+          <span className="inline-flex items-center gap-2">
+            <BadgeCheck className="h-5 w-5 text-emerald-600" aria-hidden="true" />
+            WHO-GMP certified facilities
+          </span>
+          <span>{totalBrands} brands across 5 therapeutic categories</span>
+          <a href="#franchise" className="text-[#0E4D86] underline-offset-4 hover:underline">
+            Franchise enquiries open
+          </a>
+          <Link to="/products" className="inline-flex items-center gap-1.5 text-[#0B2A57] hover:text-[#0E4D86]">
+            View all products <ArrowRight size={16} aria-hidden="true" />
+          </Link>
+        </div>
+      </div>
+    </section>
+  );
+}
diff --git a/src/index.css b/src/index.css
index 9f02710..19fda3d 100644
--- a/src/index.css
+++ b/src/index.css
@@ -780,3 +780,38 @@ a {
     transition: transform 700ms ease;
   }
 }
+
+/* Hero periodic-table tiles */
+@keyframes hero-tile-in {
+  from { opacity: 0; transform: translateY(10px) scale(0.96); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@keyframes hero-scan {
+  0% { transform: translateX(-120%); }
+  100% { transform: translateX(220%); }
+}
+
+.hero-tile-in {
+  animation: hero-tile-in 500ms ease-out both;
+}
+
+.hero-scan {
+  overflow: hidden;
+}
+
+.hero-scan::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  width: 35%;
+  background: linear-gradient(90deg, transparent, rgba(14, 77, 134, 0.14), transparent);
+  animation: hero-scan 7s ease-in-out 1.6s infinite;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hero-tile-in,
+  .hero-scan::before {
+    animation: none;
+  }
+}
